# ============================================================
# AI Universe 后端环境变量示例 —— 复制为 .env 并填写
#   cp .env.example .env
# 真实 .env 不会提交 Git。生产环境所有密钥通过平台 Secret 注入。
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development          # development | production
PORT=8080                     # Render 会自动注入 PORT，本地默认 8080

# ---------- 数据库（PostgreSQL）----------
# 本地 docker-compose： postgres://aiuniverse:aiuniverse@localhost:5432/aiuniverse
# Render：在仪表盘复制 Internal Database URL，形如
#   postgres://user:pass@dpg-xxxx.oregon-postgres.render.com/dbname
DATABASE_URL=postgres://aiuniverse:aiuniverse@localhost:5432/aiuniverse
# 生产连接 Render Postgres 需要 SSL；默认根据 NODE_ENV 自动开启，也可显式设置
DB_SSL=auto                   # auto | true | false

# ---------- 主加密密钥（AES-256-GCM，加密用户的供应商 API Key）----------
# 32 字节密钥的 base64（44 字符）。可用以下命令生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=
# 当前密钥的逻辑 ID（随密文一起记录，便于轮换），例如 k1
ENCRYPTION_KEY_ID=k1
# 可选：旧密钥（轮换时仅用于解密旧密文），JSON： {"oldId":"base64key"}
ENCRYPTION_KEYS=

# ---------- JWT / 会话 ----------
# 生成： node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---------- CORS ----------
# 逗号分隔的允许来源；留空则生产同源、开发允许 localhost
CORS_ORIGINS=

# ---------- 启动行为 ----------
RUN_MIGRATE=true              # 启动时自动执行迁移（Render release/start 均可）
RUN_SEED=true                 # 启动时幂等种子化 8 家 24 模型目录

# ---------- 平台级（服务端自带）供应商 Key（可选）----------
# 若设置，则作为该供应商的“平台共享密钥”，用户无需自带 Key。
# 留空则使用各用户自己加密托管的 Key。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=
KIMI_API_KEY=

# ---------- 费用 / 滥用保护默认值（可被用户设置覆盖）----------
DEFAULT_DAILY_BUDGET_MICRO=10000000   # 默认每日 ¥10
DEFAULT_MAX_OUTPUT_TOKENS=4096
MAX_CONCURRENT_JOBS=3           # 每用户并发生成数
RATE_LIMIT_API_PER_MIN=60       # 每用户 API 每分钟请求

# ---------- SSRF / 本地模式 ----------
# 仅本地开发允许 http（如本机 Ollama）；生产必须保持 false
ALLOW_INSECURE_LOCAL_MODE=false
# 本地模型模式：开启后仅允许显式登记的本机/局域网地址
LOCAL_MODEL_MODE=false
# LOCAL_MODEL_ALLOWLIST=http://127.0.0.1:11434

# ---------- 管理员 ----------
# 注册后将该邮箱的用户 tier 置为 admin（首个管理员引导）
ADMIN_BOOTSTRAP_EMAIL=
# 【推荐】管理员邮箱名单，逗号分隔；命中即管理员（无需角色表，大小写不敏感）。
# 未配置时：平台账号(tier=admin)或“首个注册用户”视为管理员。
ADMIN_EMAILS=

# ---------- 动态模型目录：自动发现 + 自动停用 ----------
CATALOG_DISCOVERY_ENABLED=true            # 是否启用启动/周期自动发现
CATALOG_DISCOVERY_STARTUP_DELAY_MS=8000   # 启动后延迟多久非阻塞跑一次（不阻断启动）
CATALOG_DISCOVERY_INTERVAL_HOURS=24       # 周期发现间隔；设 0 关闭（免费实例仅存活期间运行）
CATALOG_DISCOVERY_TIMEOUT_MS=15000        # 列模型请求超时
CATALOG_DEPRECATE_AFTER_MISSES=2          # discovered 模型连续 N 次未列出才停用
MODEL_PROBE_ENABLED=true                  # 是否启用自动停用探测（探测会消耗极少量 token）
MODEL_PROBE_CONCURRENCY=3                 # 探测并发上限
# 可选 Render Cron Job 调用同步端点时的签名密钥（端点校验 X-Cron-Secret 头）
CRON_SECRET=

# ---------- 全局只读紧急开关（正常留 false）----------
GLOBAL_READONLY=false
